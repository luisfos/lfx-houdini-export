<?xml version="1.0" encoding="UTF-8"?>
<shelfDocument>
  <!-- This file contains definitions of shelves, toolbars, and tools.
 It should not be hand-edited when it is being used by the application.
 Note, that two definitions of the same element are not allowed in
 a single file. -->

  <toolshelf name="LFX" label="LFX">
    <memberTool name="Pytest"/>
    <memberTool name="reload python"/>
    <memberTool name="Exporter Preferences"/>
    <memberTool name="Copy as Code"/>
    <memberTool name="Paste as Code"/>
    <memberTool name="hda2subnet"/>
  </toolshelf>

  <tool name="Pytest" label="Pytest" icon="MISC_python">
    <helpText><![CDATA["""Runs the repo pytest suite using hython and shows the output.
"""]]></helpText>
    <script scriptType="python"><![CDATA[import importlib
from lfx import pytest_runner
importlib.reload(pytest_runner)
pytest_runner.run()]]></script>
  </tool>

  <tool name="reload python" label="reload python" icon="MISC_python">
    <helpText><![CDATA["""Reloads lfx_export Python modules.
  """]]></helpText>
    <script scriptType="python"><![CDATA[import importlib    
import lfx
from lfx import pytest_runner
from lfx import exporter_callbacks
from lfx import exporter_prism_callbacks

# importlib.reload(exporter_prism_callbacks)
# importlib.reload(exporter_callbacks)
# importlib.reload(pytest_runner)
importlib.reload(lfx)]]></script>
  </tool>

  <tool name="Exporter Preferences" label="Exporter Preferences" icon="SOP_sort">
    <helpText><![CDATA["""Configure user preferences for the pipe parm tooling.
Preferences are saved into python3.11libs as a .toml.
"""]]></helpText>
    <script scriptType="python"><![CDATA[import importlib
from lfx import preferences_ui

importlib.reload(preferences_ui)
preferences_ui.show()]]></script>
  </tool>

  <tool name="Copy as Code" label="Copy as Code" icon="hicon:/SVGIcons.index?BUTTONS_copy.svg">
    <script scriptType="python"><![CDATA[import importlib
from lfx import copypasto
importlib.reload(copypasto)

modifier = kwargs.get('shiftclick') or kwargs.get('ctrlclick')
copypasto.copy_asData(compression=modifier)]]></script>
  </tool>

  <tool name="Paste as Code" label="Paste as Code" icon="hicon:/SVGIcons.index?BUTTONS_paste.svg">
    <script scriptType="python"><![CDATA[import importlib
from lfx import copypasto
importlib.reload(copypasto)

# raw = kwargs.get('shiftclick') or kwargs.get('ctrlclick')
copypasto.paste_asData()]]></script>
  </tool>

  <tool name="hda2subnet" label="HDA to Subnet" icon="SOP_subnet">
    <helpText><![CDATA["""Convert selected HDA nodes to subnets.
"""]]></helpText>
    <script scriptType="python"><![CDATA[import importlib
from lfx import hda2subnet
importlib.reload(hda2subnet)
hda2subnet.run()]]></script>
  </tool>
</shelfDocument>
