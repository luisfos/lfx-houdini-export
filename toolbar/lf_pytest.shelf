  <toolshelf name="LF_PRISM" label="LF Prism">
    <memberTool name="LF Pytest"/>
  </toolshelf>

  <tool name="LF Pytest" label="LF Pytest" icon="MISC_python">
    <helpText><![CDATA["""Runs the repo pytest suite using hython and shows the output.
"""]]></helpText>
    <script scriptType="python"><![CDATA[import importlib
import lf_pytest_runner
importlib.reload(lf_pytest_runner)
lf_pytest_runner.run()]]></script>
  </tool>
</shelfDocument>
